<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Student</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>Student Management System</h1>
    <div>
      <a href="/">Students</a>
      <a href="/students/add">Add Student</a>
    </div>
  </nav>

  <div class="container">
    <div class="card form-card">
      <h2>Edit Student</h2>
      <form action="/students/edit/<%= student.id %>" method="POST">
        <label>Student ID</label>
        <input type="text" name="student_id" value="<%= student.student_id %>" required>

        <label>First Name</label>
        <input type="text" name="first_name" value="<%= student.first_name %>" required>

        <label>Last Name</label>
        <input type="text" name="last_name" value="<%= student.last_name %>" required>

        <label>Course</label>
        <input type="text" name="course" value="<%= student.course %>" required>

        <label>Year Level</label>
        <input type="number" name="year_level" min="1" max="5" value="<%= student.year_level %>" required>

        <label>Email</label>
        <input type="email" name="email" value="<%= student.email %>" required>

        <div class="form-actions">
          <button class="btn" type="submit">Update Student</button>
          <a class="btn btn-secondary" href="/">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>