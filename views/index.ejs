<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>Student Management System</h1>
    <div>
      <a href="/">Students</a>
      <a href="/students/add">Add Student</a>
    </div>
  </nav>

  <div class="container">
    <div class="toolbar">
      <form class="search-form" action="/students/search" method="GET">
        <input type="text" name="keyword" placeholder="Search student...">
        <button class="btn" type="submit">Search</button>
        <a class="btn btn-secondary" href="/">Clear</a>
      </form>
      <a class="btn" href="/students/add">+ Add Student</a>
    </div>

    <div class="card">
      <div class="table-wrap">
        <table>
          <tr>
            <th>ID</th>
            <th>Student ID</th>
            <th>Name</th>
            <th>Course</th>
            <th>Year</th>
            <th>Email</th>
            <th>Actions</th>
          </tr>
          <% if (students.length === 0) { %>
          <tr><td class="empty" colspan="7">No students found.</td></tr>
          <% } %>
          <% students.forEach(student => { %>
          <tr>
            <td><%= student.id %></td>
            <td><%= student.student_id %></td>
            <td><%= student.first_name %> <%= student.last_name %></td>
            <td><%= student.course %></td>
            <td><%= student.year_level %></td>
            <td><%= student.email %></td>
            <td class="actions">
              <a class="btn btn-small" href="/students/edit/<%= student.id %>">Edit</a>
              <form action="/students/delete/<%= student.id %>" method="POST"
                    onsubmit="return confirm('Delete this student?')">
                <button class="btn btn-small btn-danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </table>
      </div>
    </div>
  </div>
</body>
</html>